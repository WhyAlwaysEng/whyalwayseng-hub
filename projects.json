      "assetRules": {
        "include": ["\\.(zip|tar\\.gz|deb)$"],
        "exclude": ["\\.(sha256|sig)$"],
        "osPatterns": {
          "windows": "(windows|pc-windows)",
          "macos": "(apple-darwin)",
          "linux": "(unknown-linux)"
        },
        "archPatterns": {
          "x64": "(x86_64)",
          "arm64": "(aarch64)"
        }
      },
      "install": {
        "winget": "winget install BurntSushi.ripgrep.MSVC",
        "scoop": "scoop install ripgrep",
        "brew": "brew install ripgrep",
        "cargo": "cargo install ripgrep"
