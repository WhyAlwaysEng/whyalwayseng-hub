{
  "$schema": "./schema/projects.schema.json",
  "store": {
    "name": "GitHub Software Store Hub",
    "description": "Curated zero-backend software store powered by GitHub Releases",
    "defaultLanguage": "en",
    "includePrereleaseByDefault": false
