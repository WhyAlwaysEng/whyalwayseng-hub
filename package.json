{
  "name": "github-software-store",
  "version": "1.0.0",
  "description": "Zero-backend GitHub Software Store Hub",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run validate && npm run build:catalog && npm run build:site && npm run build:css",
    "dev": "node scripts/dev-server.mjs"
  },
  "keywords": ["software-store", "github-releases", "static-site"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eta": "^3.5.0",
    "dompurify": "^3.2.4",
    "jsdom": "^26.0.0",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.9",
    "tailwindcss": "^4.0.9"
  }
}
